{
  "name": "2026-music-player",
  "version": "1.0.0",
  "description": "Music-first player with torrent streaming",
  "main": "main/index.js",
  "productName": "2026 Music Player",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icon": "node scripts/make-icon.js",
    "build": "npm run icon && node scripts/build-app.js",
    "install-app": "npm run build && rm -rf '/Applications/2026 Music Player.app' && cp -R 'dist/2026 Music Player-darwin-arm64/2026 Music Player.app' /Applications/"
  },
  "keywords": [
    "music",
    "player",
    "torrent",
    "webtorrent"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "electron": "^28.0.0"
  },
  "dependencies": {
    "@silentbot1/nat-api": "^0.4.9",
    "electron-store": "^8.1.0",
    "music-metadata": "^7.14.0",
    "webtorrent": "1.9.7"
  }
}
